{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/preship-gate",
            "timeout": 120,
            "statusMessage": "Running preship-check before commit"
          }
        ]
      }
    ]
  }
}
